# ==============================================================================
# Enterprise Knowledge Intelligence Platform (RAG + Graph RAG) Configuration
# ==============================================================================
# Quick Start Instructions:
# 1. Copy this template to '.env':
#      cp .env.example .env            # Linux/macOS
#      Copy-Item .env.example .env     # Windows PowerShell
# 2. Fill in your credentials below. Never commit real credentials to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Storage & Directory Paths
# ------------------------------------------------------------------------------
RAW_DATA_DIR=data/raw
PROCESSED_DATA_DIR=data/processed

# ------------------------------------------------------------------------------
# 2. Chunking & Structural Parsing Parameters
# ------------------------------------------------------------------------------
DEFAULT_CHUNK_SIZE=800
DEFAULT_CHUNK_OVERLAP=150

# ------------------------------------------------------------------------------
# 3. Dense Embedding Configuration
# ------------------------------------------------------------------------------
# Provider: 'sentence-transformers' (Default/Local) or 'gemini'
EMBEDDING_PROVIDER=sentence-transformers
LOCAL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
GEMINI_EMBEDDING_MODEL=text-embedding-004

# ------------------------------------------------------------------------------
# 4. PostgreSQL + pgvector Database Configuration
# ------------------------------------------------------------------------------
# For local host development: localhost
# For Docker Compose internal network: postgres
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=rag_db
DATABASE_USER=postgres
DATABASE_PASSWORD=your_postgres_password_here

# Backward-compatible POSTGRES_* aliases:
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=rag_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password_here

# Optional full database URI:
# DATABASE_URL=postgresql://postgres:your_postgres_password_here@localhost:5432/rag_db

# ------------------------------------------------------------------------------
# 5. Hybrid Retrieval (Dense Vector + BM25 Lexical + Reciprocal Rank Fusion)
# ------------------------------------------------------------------------------
VECTOR_TOP_K=20
BM25_TOP_K=20
RRF_TOP_K=20
RRF_K=60
BM25_K1=1.5
BM25_B=0.75

# ------------------------------------------------------------------------------
# 6. Cross-Encoder Reranking
# ------------------------------------------------------------------------------
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_CANDIDATE_K=20
RERANKER_TOP_K=5

# ------------------------------------------------------------------------------
# 7. Knowledge Graph Retrieval (Phase G3 / G4)
# ------------------------------------------------------------------------------
GRAPH_MAX_DEPTH=1
GRAPH_MAX_RESULTS=20
GRAPH_MAX_SEEDS=10

# ------------------------------------------------------------------------------
# 8. Grounded LLM Generation (Google Gemini)
# ------------------------------------------------------------------------------
# Required for runtime grounded synthesis and Graph extraction:
# Obtain free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

GEMINI_LLM_MODEL=gemini-3.5-flash-lite
MAX_CONTEXT_CHARS=4000

# ------------------------------------------------------------------------------
# 9. FastAPI REST API Configuration
# ------------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=false

# ------------------------------------------------------------------------------
# 10. Model Caching Strategy (Container & Host)
# ------------------------------------------------------------------------------
HF_HOME=/app/.cache/huggingface
